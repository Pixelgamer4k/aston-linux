#!/bin/sh
# Screenshot the phone (any compositor) and save it here as PNG. Usage: tools/shot OUTPUT.png [ROTATE_DEGREES]
d=$(dirname "$0")
"$d/sshs" 'drmshot 2>/dev/null | gzip -1' | gunzip > "$1.ppm" || exit 1
sips -s format png "$1.ppm" --out "$1" >/dev/null 2>&1 && rm -f "$1.ppm"
[ -n "$2" ] && sips -r "$2" "$1" >/dev/null 2>&1
exit 0
