#!/bin/sh
# ssh into Debian on the phone over the USB link. Usage: tools/sshp [-p PORT] 'command'
port=22
if [ "$1" = "-p" ]; then port=$2; shift 2; fi
exec ssh -o BatchMode=yes -o ConnectTimeout=5 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
    -i "$(dirname "$0")/../keys/aston_ed25519" -p "$port" root@169.254.42.1 "$@"
