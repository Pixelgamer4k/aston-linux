# Config fragment applied on top of the config extracted from the LineageOS
# lineage-23.2 boot image (scripts/extract-ikconfig) for LineageOS/android_kernel_oneplus_sm8550 @ 3caf896e6bc8.
# None of these change exported symbol CRCs, except SYSVIPC, which needs
# kernel-sysvipc-kabi-reserve.patch.
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y
CONFIG_FHANDLE=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
